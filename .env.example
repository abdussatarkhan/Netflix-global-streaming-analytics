# Netflix Streaming Intelligence & Personalization Platform Configuration
PROJECT_NAME="Netflix Streaming Intelligence Platform"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=netflix_admin
POSTGRES_PASSWORD=netflix_secure_pass
POSTGRES_DB=netflix_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://netflix_admin:netflix_secure_pass@localhost:5432/netflix_platform

# Fallback SQLite DB for offline testing/lightweight local runs
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=data/netflix_platform.db

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64

# Recommender Scoring Weights
WEIGHT_SEMANTIC=0.40
WEIGHT_GENRE=0.30
WEIGHT_DIRECTOR=0.15
WEIGHT_CAST=0.15

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
